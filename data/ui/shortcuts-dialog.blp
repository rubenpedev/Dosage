using Gtk 4.0;

ShortcutsWindow help_overlay {
  modal: true;

  ShortcutsSection {
    ShortcutsGroup {
      title: _("Shortcuts");

      ShortcutsShortcut {
        title: C_("shortcut window", "Show/Hide 'As Needed'");
        action-name: "app.sh-when-needed";
      }

      ShortcutsShortcut {
        title: C_("shortcut window", "New One-Time Entry");
        action-name: "app.new-one-time";
      }

      ShortcutsShortcut {
        title: C_("shortcut window", "Add New Treatment");
        action-name: "app.new-treatment";
      }

      ShortcutsShortcut {
        title: C_("shortcut window", "Show Shortcuts");
        action-name: "win.show-help-overlay";
      }

      ShortcutsShortcut {
        title: C_("shortcut window", "Quit");
        action-name: "app.quit";
      }
    }
  }
}
